diff --git a/src/tasks/phyworld_collision/models/vae.py b/src/tasks/phyworld_collision/models/vae.py
new file mode 100644
index 0000000..90aa02c
--- /dev/null
+++ b/src/tasks/phyworld_collision/models/vae.py
@@ -0,0 +1,221 @@
+"""Observation models: a conv VAE for stacked frames and an MLP VAE for state vectors.
+
+Both encoders return ``(posterior.mean, posterior)`` with ``mean`` shaped
+``(B, num_state_tokens, state_dim)``, which is the contract of the shared
+:class:`models.neo.NEO`.  The conv VAE reuses the residual blocks of the
+ImageEditing VAE and generalises its sizes: ``image_size`` 64 with an 8x8
+bottleneck gives three stride-2 stages, as 32 -> 4 does for ImageEditing.
+"""
+
+from __future__ import annotations
+
+import math
+from dataclasses import asdict, dataclass, fields
+from typing import Any, Mapping
+
+import torch
+from torch import Tensor, nn
+
+from tasks.image_editing.models.vae import GaussianPosterior, ResidualBlock, ResidualUpBlock
+from tasks.phyworld_collision.physics import STATE_DIM
+
+
+@dataclass(frozen=True, slots=True)
+class ObservationConfig:
+    """Architecture of the observation model; saved inside every checkpoint."""
+
+    modality: str = "pixels"  # "pixels" or "states"
+    state_dim: int = 256
+    num_state_tokens: int = 1
+    dropout: float = 0.0
+    # pixels
+    image_size: int = 64
+    channels: int = 6
+    base_channels: int = 64
+    bottleneck_channels: int = 256
+    bottleneck_size: int = 8
+    # states
+    input_dim: int = STATE_DIM
+    hidden_dim: int = 256
+
+    def __post_init__(self) -> None:
+        if self.modality not in ("pixels", "states"):
+            raise ValueError(f"modality must be 'pixels' or 'states', got {self.modality!r}")
+        if self.state_dim < 1 or self.num_state_tokens < 1:
+            raise ValueError("state_dim and num_state_tokens must be positive")
+        if self.modality == "pixels":
+            ratio = self.image_size / self.bottleneck_size
+            if ratio < 1 or not float(ratio).is_integer() or not math.log2(ratio).is_integer():
+                raise ValueError("image_size / bottleneck_size must be a power of two")
+
+    @property
+    def latent_dim(self) -> int:
+        return self.state_dim * self.num_state_tokens
+
+    @property
+    def num_downsamples(self) -> int:
+        return int(math.log2(self.image_size // self.bottleneck_size))
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+    @classmethod
+    def from_dict(cls, values: Mapping[str, Any]) -> "ObservationConfig":
+        known = {f.name for f in fields(cls)}
+        return cls(**{k: v for k, v in values.items() if k in known})
+
+
+def _stage_channels(config: ObservationConfig) -> list[int]:
+    channels = [config.base_channels * 2 ** (i + 1) for i in range(config.num_downsamples)]
+    if channels:
+        channels[-1] = config.bottleneck_channels
+    return channels
+
+
+def to_float_channels_first(image: Tensor, channels: int, image_size: int) -> Tensor:
+    """``(B, H, W, C)`` uint8 or ``[0, 1]`` floats -> ``(B, C, H, W)`` float32."""
+
+    if image.ndim != 4:
+        raise ValueError(f"image must be 4-dimensional, got {tuple(image.shape)}")
+    if image.shape[-1] == channels and image.shape[1] == image_size:
+        image = image.permute(0, 3, 1, 2)
+    if tuple(image.shape[1:]) != (channels, image_size, image_size):
+        raise ValueError(
+            f"expected (B, {image_size}, {image_size}, {channels}) images, got {tuple(image.shape)}"
+        )
+    if image.dtype == torch.uint8:
+        return image.float() / 255.0
+    return image.float()
+
+
+class ConvEncoder(nn.Module):
+    def __init__(self, config: ObservationConfig) -> None:
+        super().__init__()
+        self.config = config
+        self.stem = nn.Sequential(
+            nn.Conv2d(config.channels, config.base_channels, 3, padding=1, bias=False),
+            nn.BatchNorm2d(config.base_channels),
+            nn.ReLU(inplace=True),
+            ResidualBlock(config.base_channels, config.base_channels, 1, config.dropout),
+        )
+        stages = []
+        previous = config.base_channels
+        for out_channels in _stage_channels(config):
+            stages.append(ResidualBlock(previous, out_channels, 2, config.dropout))
+            previous = out_channels
+        self.stages = nn.Sequential(*stages)
+        flattened = config.bottleneck_channels * config.bottleneck_size**2
+        self.to_mean = nn.Linear(flattened, config.latent_dim)
+        self.to_logvar = nn.Linear(flattened, config.latent_dim)
+
+    def forward(self, image: Tensor) -> tuple[Tensor, GaussianPosterior]:
+        config = self.config
+        x = to_float_channels_first(image, config.channels, config.image_size)
+        features = self.stages(self.stem(x)).flatten(1)
+        shape = (x.shape[0], config.num_state_tokens, config.state_dim)
+        posterior = GaussianPosterior(
+            mean=self.to_mean(features).view(shape),
+            log_variance=self.to_logvar(features).view(shape).clamp(-20.0, 10.0),
+        )
+        return posterior.mean, posterior
+
+
+class ConvDecoder(nn.Module):
+    def __init__(self, config: ObservationConfig) -> None:
+        super().__init__()
+        self.config = config
+        flattened = config.bottleneck_channels * config.bottleneck_size**2
+        self.from_state = nn.Linear(config.latent_dim, flattened)
+        encoder_channels = [config.base_channels, *_stage_channels(config)]
+        blocks = []
+        previous = config.bottleneck_channels
+        for out_channels in reversed(encoder_channels[:-1]):
+            blocks.append(ResidualUpBlock(previous, out_channels, config.dropout))
+            previous = out_channels
+        self.blocks = nn.Sequential(*blocks)
+        self.head = nn.Sequential(nn.Conv2d(previous, config.channels, 3, padding=1), nn.Sigmoid())
+
+    def forward(self, state: Tensor) -> Tensor:
+        config = self.config
+        expected = (config.num_state_tokens, config.state_dim)
+        if state.ndim != 3 or tuple(state.shape[1:]) != expected:
+            raise ValueError(f"state must be (B, {expected[0]}, {expected[1]}), got {tuple(state.shape)}")
+        x = self.from_state(state.reshape(state.shape[0], -1)).view(
+            state.shape[0], config.bottleneck_channels, config.bottleneck_size, config.bottleneck_size
+        )
+        return self.head(self.blocks(x)).permute(0, 2, 3, 1)
+
+
+class StateEncoder(nn.Module):
+    def __init__(self, config: ObservationConfig) -> None:
+        super().__init__()
+        self.config = config
+        self.body = nn.Sequential(
+            nn.Linear(config.input_dim, config.hidden_dim),
+            nn.ReLU(),
+            nn.Linear(config.hidden_dim, config.hidden_dim),
+            nn.ReLU(),
+        )
+        self.to_mean = nn.Linear(config.hidden_dim, config.latent_dim)
+        self.to_logvar = nn.Linear(config.hidden_dim, config.latent_dim)
+
+    def forward(self, state_vector: Tensor) -> tuple[Tensor, GaussianPosterior]:
+        config = self.config
+        if state_vector.ndim != 2 or state_vector.shape[1] != config.input_dim:
+            raise ValueError(f"expected (B, {config.input_dim}) states, got {tuple(state_vector.shape)}")
+        hidden = self.body(state_vector.float())
+        shape = (state_vector.shape[0], config.num_state_tokens, config.state_dim)
+        posterior = GaussianPosterior(
+            mean=self.to_mean(hidden).view(shape),
+            log_variance=self.to_logvar(hidden).view(shape).clamp(-20.0, 10.0),
+        )
+        return posterior.mean, posterior
+
+
+class StateDecoder(nn.Module):
+    def __init__(self, config: ObservationConfig) -> None:
+        super().__init__()
+        self.config = config
+        self.body = nn.Sequential(
+            nn.Linear(config.latent_dim, config.hidden_dim),
+            nn.ReLU(),
+            nn.Linear(config.hidden_dim, config.hidden_dim),
+            nn.ReLU(),
+            nn.Linear(config.hidden_dim, config.input_dim),
+        )
+
+    def forward(self, state: Tensor) -> Tensor:
+        return self.body(state.reshape(state.shape[0], -1))
+
+
+class ObservationVAE(nn.Module):
+    """Encoder/decoder pair with ``encoder.*`` / ``decoder.*`` parameter names."""
+
+    def __init__(self, config: ObservationConfig) -> None:
+        super().__init__()
+        self.config = config
+        if config.modality == "pixels":
+            self.encoder: nn.Module = ConvEncoder(config)
+            self.decoder: nn.Module = ConvDecoder(config)
+        else:
+            self.encoder = StateEncoder(config)
+            self.decoder = StateDecoder(config)
+
+    def forward(self, observation: Tensor, *, sample: bool = True) -> tuple[Tensor, GaussianPosterior]:
+        mean, posterior = self.encoder(observation)
+        state = mean
+        if sample and self.training:
+            noise = torch.randn_like(mean)
+            state = mean + noise * torch.exp(0.5 * posterior.log_variance)
+        return self.decoder(state), posterior
+
+
+__all__ = [
+    "ConvDecoder",
+    "ConvEncoder",
+    "ObservationConfig",
+    "ObservationVAE",
+    "StateDecoder",
+    "StateEncoder",
+    "to_float_channels_first",
+]
diff --git a/src/tasks/phyworld_collision/objective.py b/src/tasks/phyworld_collision/objective.py
new file mode 100644
index 0000000..fb194d0
--- /dev/null
+++ b/src/tasks/phyworld_collision/objective.py
@@ -0,0 +1,151 @@
+"""Observation semantics supplied to the shared NEO model.
+
+Pixels
+    Observations are ``(64, 64, 6)`` uint8 (two stacked RGB frames).  The
+    loss is a **foreground-weighted L1**: pixels that belong to a ball in the
+    target get ``foreground_weight`` times the weight of white background.
+    Without it, a model can reach a low plain L1 by drawing an empty white
+    image, because the balls cover only a few percent of the pixels.
+    Grounding snaps decoded images to 8 bits, as in ImageEditing; there is no
+    exact match for continuous images.
+
+States
+    Observations are the 10-number vectors of :func:`physics.state_vector`;
+    the loss is MSE and grounding is the identity.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import torch
+from torch import Tensor
+
+
+QUANTISATION_LEVELS = 255
+FOREGROUND_THRESHOLD = 0.9  # a pixel is ball if any channel is darker than this
+
+
+@dataclass(frozen=True, slots=True)
+class CollisionMetrics:
+    """Mean absolute error overall and on ball pixels (pixels), or MSE (states)."""
+
+    l1: float
+    foreground_l1: float
+
+
+def _split_pairs(batch: Tensor) -> tuple[Tensor, Tensor]:
+    trailing = batch.shape[2:]
+    return batch[:, ::2].reshape(-1, *trailing), batch[:, 1::2].reshape(-1, *trailing)
+
+
+def _validate_pairs(batch: Tensor, *, is_eval: bool, trailing: tuple[int, ...]) -> None:
+    if batch.ndim != 2 + len(trailing):
+        raise ValueError(f"episodes must be (B, pairs*2, {trailing}), got {tuple(batch.shape)}")
+    if batch.shape[1] < 2 or batch.shape[1] % 2:
+        raise ValueError("episodes must contain an even, non-zero number of observations")
+    if tuple(batch.shape[2:]) != trailing:
+        raise ValueError(f"observations must be {trailing}, got {tuple(batch.shape[2:])}")
+    if is_eval and batch.shape[1] != 4:
+        raise ValueError("evaluation needs one support and one query pair per episode")
+
+
+def foreground_mask(target: Tensor) -> Tensor:
+    """``(..., H, W, C)`` in [0, 1] -> ``(..., H, W, 1)`` mask of non-white pixels per frame.
+
+    The six channels are two RGB frames; each frame gets its own mask.
+    """
+
+    frames = target.unflatten(-1, (-1, 3))  # (..., H, W, F, 3)
+    mask = (frames.min(dim=-1).values < FOREGROUND_THRESHOLD).float()  # (..., H, W, F)
+    return mask.repeat_interleave(3, dim=-1)
+
+
+class PixelObjective:
+    """Pairing, weighted L1, 8-bit grounding and metrics for stacked frames."""
+
+    def __init__(self, image_size: int, channels: int, foreground_weight: float) -> None:
+        self.shape = (image_size, image_size, channels)
+        self.foreground_weight = float(foreground_weight)
+
+    def validate_batch(self, batch: Tensor, *, is_eval: bool) -> None:
+        _validate_pairs(batch, is_eval=is_eval, trailing=self.shape)
+
+    def split_batch(self, batch: Tensor) -> tuple[Tensor, Tensor]:
+        return _split_pairs(batch)
+
+    @staticmethod
+    def normalize(target: Tensor) -> Tensor:
+        return target.float() / 255.0 if target.dtype == torch.uint8 else target.float()
+
+    def weights(self, target: Tensor) -> Tensor:
+        return 1.0 + (self.foreground_weight - 1.0) * foreground_mask(target)
+
+    def per_sample_reconstruction_loss(self, prediction: Tensor, target: Tensor) -> Tensor:
+        target = self.normalize(target)
+        weights = self.weights(target)
+        error = (prediction.float() - target).abs() * weights
+        return error.flatten(1).sum(dim=1) / weights.flatten(1).sum(dim=1)
+
+    def reconstruction_loss(self, prediction: Tensor, target: Tensor) -> Tensor:
+        return self.per_sample_reconstruction_loss(prediction, target).mean()
+
+    def decode_prediction(self, prediction: Tensor) -> Tensor:
+        return torch.round(prediction.clamp(0.0, 1.0) * QUANTISATION_LEVELS) / QUANTISATION_LEVELS
+
+    def exact_match(self, prediction: Tensor, target: Tensor) -> Tensor:
+        return torch.zeros(target.shape[0], dtype=torch.bool, device=prediction.device)
+
+    @torch.no_grad()
+    def metrics(self, prediction: Tensor, target: Tensor) -> CollisionMetrics:
+        target = self.normalize(target)
+        error = (prediction.float() - target).abs()
+        mask = torch.maximum(foreground_mask(target), foreground_mask(prediction.float()))
+        foreground = (error * mask).sum() / mask.sum().clamp_min(1.0)
+        return CollisionMetrics(l1=error.mean().item(), foreground_l1=foreground.item())
+
+    def empty_metrics(self) -> CollisionMetrics:
+        return CollisionMetrics(l1=0.0, foreground_l1=0.0)
+
+
+class StateObjective:
+    """Pairing, MSE and metrics for state vectors."""
+
+    def __init__(self, input_dim: int) -> None:
+        self.shape = (input_dim,)
+
+    def validate_batch(self, batch: Tensor, *, is_eval: bool) -> None:
+        _validate_pairs(batch, is_eval=is_eval, trailing=self.shape)
+
+    def split_batch(self, batch: Tensor) -> tuple[Tensor, Tensor]:
+        inputs, targets = _split_pairs(batch)
+        return inputs.float(), targets.float()
+
+    def per_sample_reconstruction_loss(self, prediction: Tensor, target: Tensor) -> Tensor:
+        return (prediction.float() - target.float()).pow(2).mean(dim=1)
+
+    def reconstruction_loss(self, prediction: Tensor, target: Tensor) -> Tensor:
+        return self.per_sample_reconstruction_loss(prediction, target).mean()
+
+    def decode_prediction(self, prediction: Tensor) -> Tensor:
+        return prediction.float()
+
+    def exact_match(self, prediction: Tensor, target: Tensor) -> Tensor:
+        return torch.zeros(target.shape[0], dtype=torch.bool, device=prediction.device)
+
+    @torch.no_grad()
+    def metrics(self, prediction: Tensor, target: Tensor) -> CollisionMetrics:
+        error = (prediction.float() - target.float()).abs()
+        return CollisionMetrics(l1=error.mean().item(), foreground_l1=error.mean().item())
+
+    def empty_metrics(self) -> CollisionMetrics:
+        return CollisionMetrics(l1=0.0, foreground_l1=0.0)
+
+
+__all__ = [
+    "CollisionMetrics",
+    "FOREGROUND_THRESHOLD",
+    "PixelObjective",
+    "StateObjective",
+    "foreground_mask",
+]
diff --git a/src/tasks/phyworld_collision/observation_pretraining.py b/src/tasks/phyworld_collision/observation_pretraining.py
new file mode 100644
index 0000000..027ef1e
--- /dev/null
+++ b/src/tasks/phyworld_collision/observation_pretraining.py
@@ -0,0 +1,247 @@
+"""Pretrain the observation VAE on single observations of the episode files.
+
+NEO keeps this model frozen, so its reconstructions bound everything NEO can
+predict.  Check ``reconstructions_epoch*.png`` in the run directory: both
+balls must be sharp and in the right place before you train NEO.
+
+Pixels (default)::
+
+    python -m tasks.phyworld_collision.observation_pretraining \\
+        --train-h5 data/collision/train.h5 --test-h5 data/collision/id_test.h5 \\
+        --output-root runs/collision/observation --epochs 30
+
+States::
+
+    python -m tasks.phyworld_collision.observation_pretraining --modality states \\
+        --state-dim 64 --train-h5 ... --test-h5 ... --output-root ... --epochs 50
+
+The run directory gets ``checkpoints/best.pt`` (lowest test loss) and
+``checkpoints/final.pt``; pass either to the NEO runner.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import time
+from pathlib import Path
+from typing import Sequence
+
+import numpy as np
+import torch
+from torch.utils.data import DataLoader, Subset
+
+from tasks.phyworld_collision.data.dataset import ObservationDataset
+from tasks.phyworld_collision.models.vae import ObservationConfig, ObservationVAE
+from tasks.phyworld_collision.objective import PixelObjective, StateObjective
+from tasks.phyworld_collision.visualize import save_rows
+from training.runtime import bfloat16_autocast, initialize_distributed, seed_everything
+
+
+def _loss_function(config: ObservationConfig, foreground_weight: float):
+    if config.modality == "pixels":
+        objective = PixelObjective(config.image_size, config.channels, foreground_weight)
+    else:
+        objective = StateObjective(config.input_dim)
+    return objective
+
+
+def _evaluate(model, loader, objective, device) -> dict[str, float]:
+    model.eval()
+    total = {"loss": 0.0, "l1": 0.0, "foreground_l1": 0.0}
+    count = 0
+    with torch.no_grad():
+        for batch in loader:
+            batch = batch.to(device)
+            with bfloat16_autocast(device):
+                reconstruction, _ = model(batch, sample=False)
+            loss = objective.reconstruction_loss(reconstruction.float(), batch)
+            metrics = objective.metrics(reconstruction.float(), batch)
+            n = batch.shape[0]
+            total["loss"] += float(loss) * n
+            total["l1"] += metrics.l1 * n
+            total["foreground_l1"] += metrics.foreground_l1 * n
+            count += n
+    return {key: value / max(count, 1) for key, value in total.items()}
+
+
+def _save_reconstructions(model, dataset, device, path: Path, count: int = 8) -> None:
+    model.eval()
+    indices = np.linspace(0, len(dataset) - 1, count).astype(int)
+    batch = torch.stack([dataset[int(i)] for i in indices]).to(device)
+    with torch.no_grad():
+        reconstruction, _ = model(batch, sample=False)
+    rows = [[batch[i].cpu().numpy(), reconstruction[i].float().cpu().numpy()] for i in range(count)]
+    save_rows(path, rows)
+
+
+def run(arguments: argparse.Namespace) -> Path:
+    seed_everything(arguments.seed)
+    context = initialize_distributed(force_cpu=arguments.cpu)
+    if context.is_distributed:
+        raise SystemExit("observation pretraining runs on one device; launch without torchrun")
+    device = context.device
+
+    train_set = ObservationDataset(arguments.train_h5, arguments.modality)
+    test_set = ObservationDataset(arguments.test_h5, arguments.modality)
+    attributes = train_set.attributes
+    config = ObservationConfig(
+        modality=arguments.modality,
+        state_dim=arguments.state_dim,
+        dropout=arguments.dropout,
+        image_size=int(attributes["image_size"]),
+        base_channels=arguments.base_channels,
+        bottleneck_channels=arguments.bottleneck_channels,
+        bottleneck_size=arguments.bottleneck_size,
+        hidden_dim=arguments.hidden_dim,
+    )
+    objective = _loss_function(config, arguments.foreground_weight)
+    model = ObservationVAE(config).to(device)
+
+    if arguments.max_test_observations and len(test_set) > arguments.max_test_observations:
+        picked = np.linspace(0, len(test_set) - 1, arguments.max_test_observations).astype(int)
+        test_subset = Subset(test_set, picked.tolist())
+    else:
+        test_subset = test_set
+    generator = torch.Generator().manual_seed(arguments.seed)
+    train_loader = DataLoader(
+        train_set,
+        batch_size=arguments.batch_size,
+        shuffle=True,
+        num_workers=arguments.num_workers,
+        pin_memory=device.type == "cuda",
+        drop_last=len(train_set) > arguments.batch_size,
+        generator=generator,
+        persistent_workers=arguments.num_workers > 0,
+    )
+    test_loader = DataLoader(
+        test_subset, batch_size=arguments.batch_size, shuffle=False, num_workers=arguments.num_workers
+    )
+
+    total_steps = arguments.epochs * max(len(train_loader), 1)
+    warmup = int(0.02 * total_steps)
+    optimizer = torch.optim.AdamW(model.parameters(), lr=arguments.learning_rate, weight_decay=0.0)
+
+    def multiplier(step: int) -> float:
+        if step < warmup:
+            return (step + 1) / warmup
+        progress = (step - warmup) / max(total_steps - warmup, 1)
+        return 0.05 + 0.95 * 0.5 * (1.0 + math.cos(math.pi * progress))
+
+    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, multiplier)
+
+    stamp = time.strftime("%Y%m%dT%H%M%S")
+    run_directory = Path(arguments.output_root).expanduser().resolve() / f"{config.modality}-{stamp}"
+    (run_directory / "checkpoints").mkdir(parents=True, exist_ok=False)
+    resolved = {
+        "observation_config": config.to_dict(),
+        "train_h5": str(train_set.path),
+        "test_h5": str(test_set.path),
+        **{k: (str(v) if isinstance(v, Path) else v) for k, v in vars(arguments).items()},
+    }
+    (run_directory / "config.json").write_text(json.dumps(resolved, indent=2))
+    log = (run_directory / "metrics.jsonl").open("x")
+
+    def save(name: str, epoch: int, metrics: dict) -> Path:
+        path = run_directory / "checkpoints" / name
+        torch.save(
+            {
+                "model_state_dict": model.state_dict(),
+                "observation_config": config.to_dict(),
+                "epoch": epoch,
+                "metrics": metrics,
+            },
+            path,
+        )
+        return path
+
+    best = math.inf
+    step = 0
+    started = time.monotonic()
+    try:
+        for epoch in range(arguments.epochs):
+            model.train()
+            for batch in train_loader:
+                batch = batch.to(device, non_blocking=True)
+                with bfloat16_autocast(device):
+                    reconstruction, posterior = model(batch)
+                reconstruction_loss = objective.reconstruction_loss(reconstruction.float(), batch)
+                kl = posterior.kl_to_standard_normal().float()
+                loss = reconstruction_loss + arguments.kl_weight * kl
+                optimizer.zero_grad(set_to_none=True)
+                loss.backward()
+                gradient_norm = torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
+                optimizer.step()
+                scheduler.step()
+                step += 1
+                if step % arguments.log_interval == 0:
+                    record = {
+                        "step": step,
+                        "epoch": epoch,
+                        "train/loss": float(loss),
+                        "train/reconstruction": float(reconstruction_loss),
+                        "train/kl": float(kl),
+                        "train/gradient_norm": float(gradient_norm),
+                        "train/lr": scheduler.get_last_lr()[0],
+                    }
+                    log.write(json.dumps(record) + "\n")
+                    log.flush()
+            metrics = _evaluate(model, test_loader, objective, device)
+            record = {"step": step, "epoch": epoch, **{f"test/{k}": v for k, v in metrics.items()}}
+            log.write(json.dumps(record) + "\n")
+            log.flush()
+            print(json.dumps(record), flush=True)
+            if config.modality == "pixels":
+                _save_reconstructions(
+                    model, test_set, device, run_directory / f"reconstructions_epoch{epoch:03d}.png"
+                )
+            if metrics["loss"] < best:
+                best = metrics["loss"]
+                save("best.pt", epoch, metrics)
+        save("final.pt", arguments.epochs - 1, metrics)
+    finally:
+        log.close()
+    (run_directory / "result.json").write_text(
+        json.dumps(
+            {"best_test_loss": best, "seconds": time.monotonic() - started, "final": metrics},
+            indent=2,
+        )
+    )
+    return run_directory
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--train-h5", type=Path, required=True)
+    parser.add_argument("--test-h5", type=Path, required=True)
+    parser.add_argument("--output-root", type=Path, required=True)
+    parser.add_argument("--modality", choices=("pixels", "states"), default="pixels")
+    parser.add_argument("--state-dim", type=int, default=256)
+    parser.add_argument("--base-channels", type=int, default=64)
+    parser.add_argument("--bottleneck-channels", type=int, default=256)
+    parser.add_argument("--bottleneck-size", type=int, default=8)
+    parser.add_argument("--hidden-dim", type=int, default=256, help="MLP width (states)")
+    parser.add_argument("--dropout", type=float, default=0.0)
+    parser.add_argument("--epochs", type=int, default=30)
+    parser.add_argument("--batch-size", type=int, default=256)
+    parser.add_argument("--learning-rate", type=float, default=1e-3)
+    parser.add_argument("--kl-weight", type=float, default=1e-5)
+    parser.add_argument("--foreground-weight", type=float, default=10.0)
+    parser.add_argument("--max-test-observations", type=int, default=8000)
+    parser.add_argument("--num-workers", type=int, default=4)
+    parser.add_argument("--log-interval", type=int, default=50)
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--cpu", action="store_true", help="force CPU (smoke tests)")
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    arguments = build_parser().parse_args(argv)
+    run_directory = run(arguments)
+    print(json.dumps({"run_directory": str(run_directory)}))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
