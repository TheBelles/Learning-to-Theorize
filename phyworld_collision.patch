--- /dev/null
+++ b/src/tasks/phyworld_collision/data/convert.py
@@ -0,0 +1,202 @@
+"""Convert a PhyWorld collision HDF5 into one Learning-to-Theorize episode file.
+
+Run it once per split.  Typical set (``k = 2`` frames per step)::
+
+    SRC=data/phyworld/collision_30K.hdf5
+    python -m tasks.phyworld_collision.data.convert --source $SRC --videos train \\
+        --deltas 1,2,3,4 --episodes 60000 --output data/collision/train.h5
+    python -m tasks.phyworld_collision.data.convert --source $SRC --videos test \\
+        --deltas 1,2,3,4 --episodes 5000 --output data/collision/id_test.h5
+    python -m tasks.phyworld_collision.data.convert --source $SRC --videos test \\
+        --deltas 5,6,7,8 --episodes 5000 --output data/collision/length_ood.h5
+    python -m tasks.phyworld_collision.data.convert --source collision_eval.hdf5 \\
+        --videos all --filter ood-velocity --deltas 1,2,3,4 --episodes 5000 \\
+        --output data/collision/velocity_ood.h5
+
+``--videos train/test`` split the source *by video* with a fixed seed, so the
+test episodes always come from videos the model never saw.  Support and query
+of an episode come from two different videos of the same chunk.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Sequence
+
+import numpy as np
+
+from tasks.phyworld_collision.data.episodes import (
+    FILTERS,
+    EpisodeWriter,
+    build_episode,
+    classify_videos,
+    rendered_frame_source,
+    valid_start_range,
+    video_split_mask,
+)
+from tasks.phyworld_collision.data.phyworld_hdf5 import PhyWorldCollisionFile
+from tasks.phyworld_collision.physics import downsample_frames
+
+
+def _parse_deltas(text: str) -> tuple[int, ...]:
+    values = tuple(sorted({int(part) for part in text.split(",") if part.strip()}))
+    if not values or min(values) < 1:
+        raise argparse.ArgumentTypeError("--deltas needs positive integers, e.g. 1,2,3,4")
+    return values
+
+
+def _allocate(counts: np.ndarray, total: int) -> np.ndarray:
+    """Split ``total`` episodes across chunks in proportion to eligible videos."""
+
+    usable = np.where(counts >= 2, counts, 0).astype(np.float64)
+    if usable.sum() == 0:
+        raise RuntimeError("no chunk has two eligible videos; check --filter and --videos")
+    raw = usable / usable.sum() * total
+    allocation = np.floor(raw).astype(int)
+    remainder = total - allocation.sum()
+    for index in np.argsort(-(raw - allocation))[:remainder]:
+        allocation[index] += 1
+    return allocation
+
+
+def convert(arguments: argparse.Namespace) -> dict:
+    rng = np.random.default_rng(arguments.seed)
+    deltas = arguments.deltas
+    has_pixels = not arguments.states_only
+    with PhyWorldCollisionFile(arguments.source) as source:
+        num_frames = None
+        chunk_info = []
+        for chunk in source.chunks():
+            num_frames = chunk.positions.shape[1]
+            labels = classify_videos(chunk.init)
+            chunk_info.append((chunk.first_index, len(chunk), labels))
+        for delta in deltas:
+            valid_start_range(delta, arguments.frame_step, num_frames)
+
+        split = video_split_mask(
+            source.num_videos,
+            arguments.videos,
+            test_fraction=arguments.test_fraction,
+            split_seed=arguments.split_seed,
+        )
+        eligible_per_chunk = []
+        for first, size, labels in chunk_info:
+            mask = FILTERS[arguments.filter](labels) & split[first : first + size]
+            eligible_per_chunk.append(np.flatnonzero(mask))
+        counts = np.array([len(e) for e in eligible_per_chunk])
+        allocation = _allocate(counts, arguments.episodes)
+
+        writer = EpisodeWriter(
+            path=arguments.output,
+            capacity=arguments.episodes,
+            image_size=arguments.image_size,
+            frame_step=arguments.frame_step,
+            deltas=deltas,
+            has_pixels=has_pixels,
+            attributes={
+                "source": str(Path(arguments.source).resolve()),
+                "videos": arguments.videos,
+                "filter": arguments.filter,
+                "render": arguments.render if has_pixels else "none",
+                "split_seed": arguments.split_seed,
+                "test_fraction": arguments.test_fraction,
+                "seed": arguments.seed,
+            },
+        )
+        label_counts: dict[str, int] = {}
+        collisions = 0
+        try:
+            for chunk, eligible, budget in zip(source.chunks(), eligible_per_chunk, allocation):
+                if budget == 0:
+                    continue
+                frame_source = None
+                if has_pixels and arguments.render == "positions":
+                    frame_source = rendered_frame_source(
+                        chunk.positions, chunk.radii, arguments.image_size
+                    )
+                elif has_pixels:
+                    decoded: dict[int, np.ndarray] = {}
+
+                    def frame_source(video: int, frames: np.ndarray, chunk=chunk, decoded=decoded):
+                        if video not in decoded:
+                            decoded[video] = downsample_frames(
+                                source.decode_video(chunk, video), arguments.image_size
+                            )
+                        return decoded[video][frames]
+
+                labels = classify_videos(chunk.init)
+                for _ in range(budget):
+                    support, query = rng.choice(eligible, size=2, replace=False)
+                    record = build_episode(
+                        rng,
+                        support_video=int(support),
+                        query_video=int(query),
+                        delta=int(rng.choice(deltas)),
+                        frame_step=arguments.frame_step,
+                        positions=chunk.positions,
+                        init=chunk.init,
+                        first_index=chunk.first_index,
+                        frame_source=frame_source,
+                        collision_fraction=arguments.collision_fraction,
+                    )
+                    writer.append(record)
+                    collisions += int(record.collides[1])
+                    for video in (support, query):
+                        label_counts[labels[video]] = label_counts.get(labels[video], 0) + 1
+                print(f"  {writer.count}/{arguments.episodes} episodes", flush=True)
+        finally:
+            writer.close()
+    summary = {
+        "output": str(arguments.output),
+        "episodes": writer.count,
+        "eligible_videos": int(counts.sum()),
+        "deltas": list(deltas),
+        "frame_step": arguments.frame_step,
+        "image_size": arguments.image_size if has_pixels else None,
+        "query_windows_with_collision": collisions / max(writer.count, 1),
+        "video_labels": label_counts,
+    }
+    return summary
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", type=Path, required=True, help="PhyWorld collision HDF5")
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--episodes", type=int, required=True)
+    parser.add_argument("--deltas", type=_parse_deltas, default=(1, 2, 3, 4))
+    parser.add_argument("--frame-step", type=int, default=2, help="raw frames per step (k)")
+    parser.add_argument("--image-size", type=int, default=64)
+    parser.add_argument(
+        "--render",
+        choices=("positions", "video"),
+        default="positions",
+        help="draw frames from stored positions (default) or decode the MP4s",
+    )
+    parser.add_argument("--states-only", action="store_true", help="skip pixels (state-vector runs)")
+    parser.add_argument("--videos", choices=("train", "test", "all"), default="all")
+    parser.add_argument("--test-fraction", type=float, default=0.1)
+    parser.add_argument("--split-seed", type=int, default=0)
+    parser.add_argument("--filter", choices=tuple(FILTERS), default="all")
+    parser.add_argument(
+        "--collision-fraction",
+        type=float,
+        help="probability that a window contains the contact (default: natural rate)",
+    )
+    parser.add_argument("--seed", type=int, default=0)
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    arguments = build_parser().parse_args(argv)
+    if arguments.frame_step < 1:
+        raise SystemExit("--frame-step must be positive")
+    summary = convert(arguments)
+    print(json.dumps(summary, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/tasks/phyworld_collision/data/dataset.py b/src/tasks/phyworld_collision/data/dataset.py
new file mode 100644
index 0000000..4510cfc
--- /dev/null
+++ b/src/tasks/phyworld_collision/data/dataset.py
@@ -0,0 +1,153 @@
+"""PyTorch datasets over the episode files written by :mod:`.convert`."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Sequence
+
+import numpy as np
+import torch
+from torch.utils.data import Dataset
+
+from tasks.phyworld_collision.data.episodes import read_attributes
+
+
+MODALITIES = ("pixels", "states")
+
+
+def _h5py() -> Any:
+    import h5py
+
+    return h5py
+
+
+class _LazyHDF5:
+    """Open the HDF5 file on first use in each process (h5py handles cannot be forked)."""
+
+    def __init__(self, path: str | Path, modality: str) -> None:
+        if modality not in MODALITIES:
+            raise ValueError(f"modality must be one of {MODALITIES}, got {modality!r}")
+        self.path = Path(path).expanduser().resolve(strict=True)
+        self.modality = modality
+        self.attributes = read_attributes(self.path)
+        if modality == "pixels" and not bool(self.attributes["has_pixels"]):
+            raise ValueError(f"{self.path} was converted with --states-only")
+        self.key = "grids" if modality == "pixels" else "states"
+        self.num_episodes = int(self.attributes["dataset_length"])
+        self._handle: Any | None = None
+
+    @property
+    def handle(self) -> Any:
+        if self._handle is None:
+            self._handle = _h5py().File(self.path, "r")
+        return self._handle
+
+    def __getstate__(self) -> dict:
+        state = self.__dict__.copy()
+        state["_handle"] = None
+        return state
+
+
+class EpisodeDataset(Dataset):
+    """Episodes as ``(4, S, S, 6)`` uint8 (pixels) or ``(4, 10)`` float32 (states).
+
+    Items are ``(observations, episode_index)`` so evaluation can look up the
+    metadata (delta, collisions, true positions) of each episode.
+    """
+
+    def __init__(self, path: str | Path, modality: str) -> None:
+        self._file = _LazyHDF5(path, modality)
+
+    @property
+    def attributes(self) -> dict:
+        return self._file.attributes
+
+    @property
+    def path(self) -> Path:
+        return self._file.path
+
+    def __len__(self) -> int:
+        return self._file.num_episodes
+
+    def __getitem__(self, index: int) -> tuple[torch.Tensor, int]:
+        if not 0 <= index < len(self):
+            raise IndexError(index)
+        array = np.asarray(self._file.handle[self._file.key][index])
+        return torch.from_numpy(array), index
+
+
+class ObservationDataset(Dataset):
+    """Every single observation of an episode file, for observation-model pretraining."""
+
+    def __init__(self, path: str | Path, modality: str) -> None:
+        self._file = _LazyHDF5(path, modality)
+
+    @property
+    def attributes(self) -> dict:
+        return self._file.attributes
+
+    @property
+    def path(self) -> Path:
+        return self._file.path
+
+    def __len__(self) -> int:
+        return 4 * self._file.num_episodes
+
+    def __getitem__(self, index: int) -> torch.Tensor:
+        episode, slot = divmod(index, 4)
+        return torch.from_numpy(np.asarray(self._file.handle[self._file.key][episode, slot]))
+
+
+@dataclass(frozen=True, slots=True)
+class EpisodeBatch:
+    """A collated batch: ``observations`` is ``(B, 4, ...)``."""
+
+    observations: torch.Tensor
+    indices: torch.Tensor
+
+    def to(self, device: torch.device | str) -> "EpisodeBatch":
+        return EpisodeBatch(self.observations.to(device, non_blocking=True), self.indices)
+
+    def __len__(self) -> int:
+        return self.observations.shape[0]
+
+
+def collate_episodes(items: Sequence[tuple[torch.Tensor, int]]) -> EpisodeBatch:
+    return EpisodeBatch(
+        observations=torch.stack([item[0] for item in items]),
+        indices=torch.tensor([item[1] for item in items], dtype=torch.long),
+    )
+
+
+@dataclass(frozen=True, slots=True)
+class EpisodeMetadata:
+    """Per-episode ground truth used by the evaluation."""
+
+    delta: np.ndarray  # (N,)
+    collides: np.ndarray  # (N, 2) support, query
+    positions: np.ndarray  # (N, 4, 2, 2, 2)
+    radii: np.ndarray  # (N, 2, 2)
+    init: np.ndarray  # (N, 2, 4)
+
+
+def load_metadata(path: str | Path) -> EpisodeMetadata:
+    with _h5py().File(path, "r") as handle:
+        return EpisodeMetadata(
+            delta=np.asarray(handle["delta"][:], dtype=np.int64),
+            collides=np.asarray(handle["collides"][:], dtype=bool),
+            positions=np.asarray(handle["positions"][:], dtype=np.float64),
+            radii=np.asarray(handle["radii"][:], dtype=np.float64),
+            init=np.asarray(handle["init"][:], dtype=np.float64),
+        )
+
+
+__all__ = [
+    "EpisodeBatch",
+    "EpisodeDataset",
+    "EpisodeMetadata",
+    "MODALITIES",
+    "ObservationDataset",
+    "collate_episodes",
+    "load_metadata",
+]
diff --git a/src/tasks/phyworld_collision/data/episodes.py b/src/tasks/phyworld_collision/data/episodes.py
new file mode 100644
index 0000000..f561295
--- /dev/null
+++ b/src/tasks/phyworld_collision/data/episodes.py
@@ -0,0 +1,367 @@
+"""Turn collision videos into Learning-to-Theorize episodes.
+
+Task definition ("advance time by delta steps")
+-----------------------------------------------
+* An **observation** at frame ``t`` is two frames, ``t - k`` and ``t``, where
+  ``k = frame_step``.  Two frames make the state Markov: they show positions
+  *and* velocities.  Pixels are stacked on the channel axis, ``(S, S, 6)``;
+  the state version is the 10-number vector of :func:`physics.state_vector`.
+* A **pair** is ``x = obs(t)`` and ``y = obs(t + delta * k)``.
+* An **episode** is a support pair from video A and a query pair from a
+  different video B with the **same delta**.  NEO infers a program on the
+  support pair and must reuse it on the query pair, so the only thing the
+  two pairs share is "advance time by delta steps": the physics.
+
+Episode file layout (one HDF5 per split)
+----------------------------------------
+Root attributes: ``format``, ``dataset_length``, ``image_size``,
+``frame_step``, ``deltas``, ``has_pixels``, ``source``, ``split``.
+
+==================  ======================  ==========================================
+dataset             shape / dtype           meaning
+==================  ======================  ==========================================
+grids               (N, 4, S, S, 6) uint8   x_support, y_support, x_query, y_query
+states              (N, 4, 10) float32      same four observations as state vectors
+positions           (N, 4, 2, 2, 2) f32     true positions: obs, frame (t-k, t), ball, xy
+radii               (N, 2, 2) f32           support/query video, ball
+init                (N, 2, 4) f32           r1, r2, v1, v2 of the support/query video
+delta               (N,) int16              steps advanced (frames = delta * frame_step)
+collides            (N, 2) bool             contact inside the support/query window
+video_index         (N, 2) int64            global video index in the source file
+start_frame         (N, 2) int16            t of the support/query input observation
+==================  ======================  ==========================================
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Callable
+
+import numpy as np
+
+from tasks.phyworld_collision.physics import (
+    ID_RADIUS_RANGE,
+    ID_VELOCITY_RANGE,
+    STATE_DIM,
+    collision_frame,
+    render_frames,
+    state_vector,
+    window_contains_collision,
+)
+
+
+FORMAT = "l2t-phyworld-collision-episodes-v1"
+CHANNELS = 6
+OBSERVATIONS_PER_EPISODE = 4
+
+
+# ---------------------------------------------------------------------------
+# Video selection
+# ---------------------------------------------------------------------------
+
+
+def classify_videos(init: np.ndarray, *, tol: float = 1e-6) -> np.ndarray:
+    """Label each ``(r1, r2, v1, v2)`` row as id / ood-velocity / ood-radius / ood-both."""
+
+    init = np.asarray(init, dtype=np.float64)
+    v_ok = np.all(
+        (init[:, 2:] >= ID_VELOCITY_RANGE[0] - tol) & (init[:, 2:] <= ID_VELOCITY_RANGE[1] + tol),
+        axis=1,
+    )
+    r_ok = np.all(
+        (init[:, :2] >= ID_RADIUS_RANGE[0] - tol) & (init[:, :2] <= ID_RADIUS_RANGE[1] + tol),
+        axis=1,
+    )
+    labels = np.full(len(init), "ood-both", dtype=object)
+    labels[v_ok & r_ok] = "id"
+    labels[~v_ok & r_ok] = "ood-velocity"
+    labels[v_ok & ~r_ok] = "ood-radius"
+    return labels
+
+
+FILTERS: dict[str, Callable[[np.ndarray], np.ndarray]] = {
+    "all": lambda labels: np.ones(len(labels), dtype=bool),
+    "id": lambda labels: labels == "id",
+    "ood": lambda labels: labels != "id",
+    "ood-velocity": lambda labels: labels == "ood-velocity",
+    "ood-radius": lambda labels: labels == "ood-radius",
+}
+
+
+def video_split_mask(
+    num_videos: int, which: str, *, test_fraction: float, split_seed: int
+) -> np.ndarray:
+    """Deterministic train/test split *by video*, so test videos are never trained on."""
+
+    if which == "all":
+        return np.ones(num_videos, dtype=bool)
+    order = np.random.default_rng(split_seed).permutation(num_videos)
+    is_test = np.zeros(num_videos, dtype=bool)
+    is_test[order[: int(round(test_fraction * num_videos))]] = True
+    if which == "test":
+        return is_test
+    if which == "train":
+        return ~is_test
+    raise ValueError(f"unknown video split {which!r}")
+
+
+# ---------------------------------------------------------------------------
+# Windows
+# ---------------------------------------------------------------------------
+
+
+def valid_start_range(delta: int, frame_step: int, num_frames: int) -> tuple[int, int]:
+    """Inclusive range of input frames ``t`` with room for ``t - k`` and ``t + delta * k``."""
+
+    low = frame_step
+    high = num_frames - 1 - delta * frame_step
+    if high < low:
+        raise ValueError(
+            f"delta={delta} with frame_step={frame_step} does not fit in {num_frames} frames"
+        )
+    return low, high
+
+
+def sample_start(
+    rng: np.random.Generator,
+    *,
+    delta: int,
+    frame_step: int,
+    num_frames: int,
+    contact: int,
+    want_collision: bool | None,
+) -> int:
+    """Pick the input frame ``t``; optionally force the window to (not) contain the contact.
+
+    The window spans frames ``[t - k, t + delta * k]``.  If the requested
+    condition cannot be met for this video, a uniform start is returned.
+    """
+
+    low, high = valid_start_range(delta, frame_step, num_frames)
+    starts = np.arange(low, high + 1)
+    if want_collision is not None:
+        inside = np.array(
+            [
+                window_contains_collision(contact, t - frame_step, t + delta * frame_step)
+                for t in starts
+            ]
+        )
+        candidates = starts[inside] if want_collision else starts[~inside]
+        if candidates.size:
+            starts = candidates
+    return int(rng.choice(starts))
+
+
+# ---------------------------------------------------------------------------
+# Observations
+# ---------------------------------------------------------------------------
+
+
+def pixel_observation(frames: np.ndarray, t: int, frame_step: int) -> np.ndarray:
+    """``(S, S, 6)`` uint8: frame ``t - k`` in channels 0-2, frame ``t`` in 3-5."""
+
+    return np.concatenate([frames[t - frame_step], frames[t]], axis=-1)
+
+
+@dataclass(slots=True)
+class EpisodeRecord:
+    """One episode before it is written (all four observations)."""
+
+    grids: np.ndarray | None
+    states: np.ndarray
+    positions: np.ndarray
+    radii: np.ndarray
+    init: np.ndarray
+    delta: int
+    collides: np.ndarray
+    video_index: np.ndarray
+    start_frame: np.ndarray
+
+
+FrameSource = Callable[[int, np.ndarray], np.ndarray]
+"""``(local_video_index, frame_indices) -> (len(frame_indices), S, S, 3)`` uint8."""
+
+
+def rendered_frame_source(positions: np.ndarray, radii: np.ndarray, image_size: int) -> FrameSource:
+    """Render frames from stored positions (fast, no MP4 artefacts)."""
+
+    def source(video: int, frame_indices: np.ndarray) -> np.ndarray:
+        return render_frames(positions[video, frame_indices], radii[video], image_size)
+
+    return source
+
+
+def build_episode(
+    rng: np.random.Generator,
+    *,
+    support_video: int,
+    query_video: int,
+    delta: int,
+    frame_step: int,
+    positions: np.ndarray,
+    init: np.ndarray,
+    first_index: int,
+    frame_source: FrameSource | None,
+    collision_fraction: float | None,
+) -> EpisodeRecord:
+    """Assemble one support/query episode from two videos of the same chunk."""
+
+    num_frames = positions.shape[1]
+    videos = (support_video, query_video)
+    grids, states, true_positions, starts, collides = [], [], [], [], []
+    for video in videos:
+        contact = collision_frame(positions[video], init[video, :2])
+        want = None
+        if collision_fraction is not None:
+            want = bool(rng.random() < collision_fraction)
+        t = sample_start(
+            rng,
+            delta=delta,
+            frame_step=frame_step,
+            num_frames=num_frames,
+            contact=contact,
+            want_collision=want,
+        )
+        t_out = t + delta * frame_step
+        starts.append(t)
+        collides.append(window_contains_collision(contact, t - frame_step, t_out))
+        for end in (t, t_out):
+            states.append(state_vector(positions[video], init[video, :2], end, frame_step))
+            true_positions.append(positions[video, [end - frame_step, end]])
+        if frame_source is not None:
+            needed = np.array([t - frame_step, t, t_out - frame_step, t_out])
+            frames = frame_source(video, needed)
+            grids.append(np.concatenate([frames[0], frames[1]], axis=-1))
+            grids.append(np.concatenate([frames[2], frames[3]], axis=-1))
+    return EpisodeRecord(
+        grids=np.stack(grids).astype(np.uint8) if frame_source is not None else None,
+        states=np.stack(states).astype(np.float32),
+        positions=np.stack(true_positions).astype(np.float32),
+        radii=init[list(videos), :2].astype(np.float32),
+        init=init[list(videos)].astype(np.float32),
+        delta=int(delta),
+        collides=np.asarray(collides, dtype=bool),
+        video_index=np.asarray([first_index + v for v in videos], dtype=np.int64),
+        start_frame=np.asarray(starts, dtype=np.int16),
+    )
+
+
+# ---------------------------------------------------------------------------
+# HDF5 I/O
+# ---------------------------------------------------------------------------
+
+
+def _h5py() -> Any:
+    try:
+        import h5py
+    except ImportError as error:  # pragma: no cover - environment dependent
+        raise RuntimeError("h5py is required to write episode files") from error
+    return h5py
+
+
+@dataclass
+class EpisodeWriter:
+    """Append episodes to a new HDF5 file (see the module docstring for the layout)."""
+
+    path: Path
+    capacity: int
+    image_size: int
+    frame_step: int
+    deltas: tuple[int, ...]
+    has_pixels: bool
+    attributes: dict[str, Any] = field(default_factory=dict)
+    compression_level: int = 4
+
+    def __post_init__(self) -> None:
+        h5py = _h5py()
+        self.path = Path(self.path)
+        if self.path.exists():
+            raise FileExistsError(f"refusing to overwrite {self.path}")
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self._file = h5py.File(self.path, "w")
+        n, s = self.capacity, self.image_size
+        create = self._file.create_dataset
+        if self.has_pixels:
+            create(
+                "grids",
+                shape=(n, 4, s, s, CHANNELS),
+                maxshape=(None, 4, s, s, CHANNELS),
+                dtype=np.uint8,
+                chunks=(1, 4, s, s, CHANNELS),
+                compression="gzip",
+                compression_opts=self.compression_level,
+            )
+        create("states", shape=(n, 4, STATE_DIM), maxshape=(None, 4, STATE_DIM), dtype=np.float32)
+        create("positions", shape=(n, 4, 2, 2, 2), maxshape=(None, 4, 2, 2, 2), dtype=np.float32)
+        create("radii", shape=(n, 2, 2), maxshape=(None, 2, 2), dtype=np.float32)
+        create("init", shape=(n, 2, 4), maxshape=(None, 2, 4), dtype=np.float32)
+        create("delta", shape=(n,), maxshape=(None,), dtype=np.int16)
+        create("collides", shape=(n, 2), maxshape=(None, 2), dtype=bool)
+        create("video_index", shape=(n, 2), maxshape=(None, 2), dtype=np.int64)
+        create("start_frame", shape=(n, 2), maxshape=(None, 2), dtype=np.int16)
+        self.count = 0
+
+    def append(self, record: EpisodeRecord) -> None:
+        if self.count >= self.capacity:
+            raise RuntimeError("episode writer is full")
+        i = self.count
+        if self.has_pixels:
+            if record.grids is None:
+                raise ValueError("pixel episode file needs grids")
+            self._file["grids"][i] = record.grids
+        self._file["states"][i] = record.states
+        self._file["positions"][i] = record.positions
+        self._file["radii"][i] = record.radii
+        self._file["init"][i] = record.init
+        self._file["delta"][i] = record.delta
+        self._file["collides"][i] = record.collides
+        self._file["video_index"][i] = record.video_index
+        self._file["start_frame"][i] = record.start_frame
+        self.count += 1
+
+    def close(self) -> None:
+        if self._file is None:
+            return
+        for name in list(self._file.keys()):
+            self._file[name].resize(self.count, axis=0)
+        attrs = self._file.attrs
+        attrs["format"] = FORMAT
+        attrs["dataset_length"] = self.count
+        attrs["image_size"] = self.image_size
+        attrs["frame_step"] = self.frame_step
+        attrs["deltas"] = np.asarray(self.deltas, dtype=np.int64)
+        attrs["has_pixels"] = self.has_pixels
+        attrs["state_dim"] = STATE_DIM
+        for key, value in self.attributes.items():
+            attrs[key] = value
+        self._file.close()
+        self._file = None
+
+
+def read_attributes(path: str | Path) -> dict[str, Any]:
+    """Root attributes of an episode file, validated."""
+
+    h5py = _h5py()
+    with h5py.File(path, "r") as handle:
+        attrs = {key: handle.attrs[key] for key in handle.attrs}
+    if attrs.get("format") != FORMAT:
+        raise ValueError(f"{path} is not a {FORMAT} file (format={attrs.get('format')!r})")
+    return attrs
+
+
+__all__ = [
+    "CHANNELS",
+    "EpisodeRecord",
+    "EpisodeWriter",
+    "FILTERS",
+    "FORMAT",
+    "build_episode",
+    "classify_videos",
+    "pixel_observation",
+    "read_attributes",
+    "rendered_frame_source",
+    "sample_start",
+    "valid_start_range",
+    "video_split_mask",
+]
diff --git a/src/tasks/phyworld_collision/data/phyworld_hdf5.py b/src/tasks/phyworld_collision/data/phyworld_hdf5.py
new file mode 100644
index 0000000..d89b24a
--- /dev/null
+++ b/src/tasks/phyworld_collision/data/phyworld_hdf5.py
@@ -0,0 +1,258 @@
+"""Read (and write) PhyWorld collision HDF5 files.
+
+PhyWorld's generator merges per-chunk files into one HDF5 with three groups,
+each holding one dataset per chunk of up to 1000 videos::
+
+    video_streams/<chunk>     vlen uint8, one MP4 byte stream per video
+    position_streams/<chunk>  float  (N, 32, 2, 2)   frame, ball, xy (world units)
+    init_streams/<chunk>      float  (N, 4)          r1, r2, v1, v2
+
+The released files on Hugging Face (``magicr/phyworld``) are not documented
+beyond this, so the reader also accepts the three names as plain datasets and
+finds them in nested groups (e.g. one group per OOD level).  Run
+``python -m tasks.phyworld_collision.data.phyworld_hdf5 FILE`` to print the
+layout of a file before converting it.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass
+from io import BytesIO
+from pathlib import Path
+from typing import Any, Iterator, Sequence
+
+import numpy as np
+
+from tasks.phyworld_collision.physics import NUM_FRAMES, render_frames
+
+
+POSITIONS = "position_streams"
+INIT = "init_streams"
+VIDEOS = "video_streams"
+
+
+def _h5py() -> Any:
+    try:
+        import h5py
+    except ImportError as error:  # pragma: no cover - environment dependent
+        raise RuntimeError("h5py is required to read PhyWorld files") from error
+    return h5py
+
+
+@dataclass(frozen=True, slots=True)
+class Chunk:
+    """One block of videos from a PhyWorld file, loaded into memory."""
+
+    collection: str
+    name: str
+    first_index: int  # global index of the first video in this chunk
+    positions: np.ndarray  # (N, T, 2, 2) float64
+    init: np.ndarray  # (N, 4) float64: r1, r2, v1, v2
+    has_video: bool
+
+    def __len__(self) -> int:
+        return self.positions.shape[0]
+
+    @property
+    def radii(self) -> np.ndarray:
+        return self.init[:, :2]
+
+
+def _collections(handle: Any) -> list[str]:
+    """Paths of groups that contain both ``position_streams`` and ``init_streams``."""
+
+    found: list[str] = []
+
+    def visit(path: str, group: Any) -> None:
+        if POSITIONS in group and INIT in group:
+            found.append(path)
+            return
+        for key in sorted(group.keys()):
+            item = group[key]
+            if hasattr(item, "keys"):
+                visit(f"{path}/{key}" if path else key, item)
+
+    visit("", handle)
+    if not found:
+        raise ValueError(
+            f"no group with {POSITIONS!r} and {INIT!r} found; run the inspector "
+            "(python -m tasks.phyworld_collision.data.phyworld_hdf5 FILE) to see the layout"
+        )
+    return found
+
+
+def _chunk_names(node: Any) -> list[str | None]:
+    """Chunk dataset names of a stream group, or ``[None]`` for a plain dataset."""
+
+    if hasattr(node, "keys"):
+        return sorted(node.keys())
+    return [None]
+
+
+def _read(node: Any, name: str | None) -> Any:
+    return node if name is None else node[name]
+
+
+class PhyWorldCollisionFile:
+    """Iterate over the videos of one PhyWorld collision file, chunk by chunk."""
+
+    def __init__(self, path: str | Path) -> None:
+        self.path = Path(path).expanduser().resolve(strict=True)
+        h5py = _h5py()
+        self._handle = h5py.File(self.path, "r")
+        self.collections = _collections(self._handle)
+        self._index: list[tuple[str, str | None, int, int]] = []
+        total = 0
+        for collection in self.collections:
+            group = self._handle[collection] if collection else self._handle
+            for name in _chunk_names(group[POSITIONS]):
+                count = int(_read(group[POSITIONS], name).shape[0])
+                self._index.append((collection, name, total, count))
+                total += count
+        self.num_videos = total
+
+    def close(self) -> None:
+        self._handle.close()
+
+    def __enter__(self) -> "PhyWorldCollisionFile":
+        return self
+
+    def __exit__(self, *_: object) -> None:
+        self.close()
+
+    def chunks(self) -> Iterator[Chunk]:
+        for collection, name, first, _ in self._index:
+            group = self._handle[collection] if collection else self._handle
+            positions = np.asarray(_read(group[POSITIONS], name), dtype=np.float64)
+            init = np.asarray(_read(group[INIT], name), dtype=np.float64)
+            if positions.ndim != 4 or positions.shape[2:] != (2, 2):
+                raise ValueError(
+                    f"{collection}/{POSITIONS}/{name}: expected (N, T, 2, 2), got {positions.shape}"
+                )
+            if init.shape != (positions.shape[0], 4):
+                raise ValueError(
+                    f"{collection}/{INIT}/{name}: expected ({positions.shape[0]}, 4), got {init.shape}"
+                )
+            yield Chunk(
+                collection=collection,
+                name=name or "",
+                first_index=first,
+                positions=positions,
+                init=init,
+                has_video=VIDEOS in group,
+            )
+
+    def video_bytes(self, chunk: Chunk, index: int) -> bytes:
+        group = self._handle[chunk.collection] if chunk.collection else self._handle
+        if VIDEOS not in group:
+            raise ValueError(f"{self.path} has no {VIDEOS}; use --render positions")
+        stream = _read(group[VIDEOS], chunk.name or None)[index]
+        return np.asarray(stream, dtype=np.uint8).tobytes()
+
+    def decode_video(self, chunk: Chunk, index: int) -> np.ndarray:
+        """Decode one MP4 into ``(T, H, W, 3)`` uint8 frames."""
+
+        import imageio.v3 as iio
+
+        frames = iio.imread(self.video_bytes(chunk, index), extension=".mp4")
+        return np.asarray(frames)[..., :3]
+
+
+# ---------------------------------------------------------------------------
+# Writing PhyWorld-format files (used by the simulator)
+# ---------------------------------------------------------------------------
+
+
+def encode_mp4(frames: np.ndarray, fps: int = 5) -> np.ndarray:
+    """Encode frames to an MP4 byte stream like PhyWorld (needs imageio-ffmpeg)."""
+
+    import imageio.v3 as iio
+
+    with BytesIO() as buffer:
+        iio.imwrite(buffer, frames, extension=".mp4", fps=fps)
+        return np.frombuffer(buffer.getvalue(), dtype=np.uint8)
+
+
+def write_phyworld_file(
+    path: str | Path,
+    positions: np.ndarray,
+    init: np.ndarray,
+    *,
+    chunk_size: int = 1000,
+    with_video: bool = False,
+    video_size: int = 256,
+) -> None:
+    """Write videos in PhyWorld's merged layout (groups of chunk datasets)."""
+
+    h5py = _h5py()
+    path = Path(path)
+    if path.exists():
+        raise FileExistsError(f"refusing to overwrite {path}")
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with h5py.File(path, "w") as handle:
+        groups = {key: handle.create_group(key) for key in (POSITIONS, INIT)}
+        if with_video:
+            groups[VIDEOS] = handle.create_group(VIDEOS)
+        for chunk_id, start in enumerate(range(0, len(positions), chunk_size)):
+            stop = min(start + chunk_size, len(positions))
+            name = f"{chunk_id:05d}"
+            groups[POSITIONS].create_dataset(name, data=positions[start:stop])
+            groups[INIT].create_dataset(name, data=init[start:stop])
+            if with_video:
+                dataset = groups[VIDEOS].create_dataset(
+                    name, shape=(stop - start,), dtype=h5py.vlen_dtype(np.dtype("uint8"))
+                )
+                for offset, index in enumerate(range(start, stop)):
+                    frames = render_frames(positions[index], init[index, :2], video_size)
+                    dataset[offset] = encode_mp4(frames)
+
+
+# ---------------------------------------------------------------------------
+# Inspector
+# ---------------------------------------------------------------------------
+
+
+def describe(path: str | Path, *, max_items: int = 6) -> str:
+    """Human-readable tree of an HDF5 file (first few items per group)."""
+
+    h5py = _h5py()
+    lines: list[str] = []
+
+    def visit(name: str, node: Any, depth: int) -> None:
+        indent = "  " * depth
+        if hasattr(node, "keys"):
+            keys = sorted(node.keys())
+            lines.append(f"{indent}{name or '/'}/  ({len(keys)} items)")
+            for key in keys[:max_items]:
+                visit(key, node[key], depth + 1)
+            if len(keys) > max_items:
+                lines.append(f"{indent}  ... {len(keys) - max_items} more")
+        else:
+            lines.append(f"{indent}{name}  shape={node.shape} dtype={node.dtype}")
+
+    with h5py.File(path, "r") as handle:
+        visit("", handle, 0)
+        for key, value in handle.attrs.items():
+            lines.append(f"attr {key} = {value!r}")
+    return "\n".join(lines)
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Print the layout of a PhyWorld HDF5 file")
+    parser.add_argument("path", type=Path)
+    parser.add_argument("--max-items", type=int, default=6)
+    arguments = parser.parse_args(argv)
+    print(describe(arguments.path, max_items=arguments.max_items))
+    with PhyWorldCollisionFile(arguments.path) as source:
+        print(f"\ncollections: {source.collections or ['/']}")
+        print(f"videos: {source.num_videos}")
+        chunk = next(source.chunks())
+        print(f"first chunk: {chunk.collection}/{chunk.name} ({len(chunk)} videos), "
+              f"frames per video: {chunk.positions.shape[1]} (expected {NUM_FRAMES})")
+        print(f"init (r1, r2, v1, v2) of first 3 videos:\n{chunk.init[:3]}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/tasks/phyworld_collision/data/simulate.py b/src/tasks/phyworld_collision/data/simulate.py
new file mode 100644
index 0000000..0001bfa
--- /dev/null
+++ b/src/tasks/phyworld_collision/data/simulate.py
@@ -0,0 +1,132 @@
+"""Generate PhyWorld-format collision files without Box2D.
+
+Useful for (a) a quick smoke test before downloading the real data and
+(b) building OOD evaluation sets with exactly the ranges you want.  The
+parameter grids follow PhyWorld's ``two_balls_collision.py``:
+
+* ``id-30k``: v1, v2 on 21 values in [1, 4]; r1, r2 on 8 values in [0.5, 1.5]
+  (28,224 combinations, the "30K" training set);
+* ``id-eval``: 15 random speeds and 5 random radii in the ID ranges;
+* ``ood-velocity-low`` / ``ood-velocity-high``: one or both speeds in
+  [0, 0.8] / [4.5, 6.0], radii in distribution (PhyWorld levels 2 and 4);
+* ``ood-radius-low`` / ``ood-radius-high``: one or both radii in
+  [0.3, 0.4] / [1.7, 2.0], speeds in distribution (levels 1 and 3);
+* ``tiny``: 4 speeds x 3 radii, for tests.
+
+The motion is the closed-form 1D collision of :mod:`..physics`; contacts
+slower than Box2D's 1 unit/s velocity threshold are inelastic, as in Box2D.
+
+Example::
+
+    python -m tasks.phyworld_collision.data.simulate --preset ood-velocity-high \\
+        --output data/phyworld/collision_ood_velocity_high.hdf5
+"""
+
+from __future__ import annotations
+
+import argparse
+import itertools
+from pathlib import Path
+from typing import Sequence
+
+import numpy as np
+
+from tasks.phyworld_collision.data.phyworld_hdf5 import write_phyworld_file
+from tasks.phyworld_collision.physics import (
+    ID_RADIUS_RANGE,
+    ID_VELOCITY_RANGE,
+    sample_initial_positions,
+    simulate_collision,
+)
+
+
+def _grid(r1s, r2s, v1s, v2s) -> list[tuple[float, float, float, float]]:
+    return [tuple(map(float, c)) for c in itertools.product(r1s, r2s, v1s, v2s)]
+
+
+def preset_combinations(name: str, rng: np.random.Generator) -> list[tuple[float, float, float, float]]:
+    """``(r1, r2, v1, v2)`` combinations of a named preset."""
+
+    v_lo, v_hi = ID_VELOCITY_RANGE
+    r_lo, r_hi = ID_RADIUS_RANGE
+    v_id = np.linspace(v_lo, v_hi, 16)[::2]
+    r_id = np.linspace(r_lo, r_hi, 6)
+    if name == "id-30k":
+        v, r = np.linspace(v_lo, v_hi, 21), np.linspace(r_lo, r_hi, 8)
+        return _grid(r, r, v, v)
+    if name == "id-eval":
+        v = np.sort(rng.uniform(v_lo, v_hi, 15))
+        r = np.sort(rng.uniform(r_lo, r_hi, 5))
+        return _grid(r, r, v, v)
+    if name in ("ood-velocity-low", "ood-velocity-high"):
+        v_ood = np.linspace(0.0, 0.8, 11) if name.endswith("low") else np.linspace(4.5, 6.0, 6)
+        return _grid(r_id, r_id, v_ood, v_id) + _grid(r_id, r_id, v_ood, v_ood)
+    if name in ("ood-radius-low", "ood-radius-high"):
+        r_ood = np.linspace(0.3, 0.4, 11) if name.endswith("low") else np.linspace(1.7, 2.0, 6)
+        return _grid(r_ood, r_id, v_id, v_id) + _grid(r_ood, r_ood, v_id, v_id)
+    if name == "tiny":
+        v, r = np.linspace(v_lo, v_hi, 4), np.linspace(r_lo, r_hi, 3)
+        return _grid(r, r, v, v)
+    raise ValueError(f"unknown preset {name!r}")
+
+
+PRESETS = (
+    "id-30k",
+    "id-eval",
+    "ood-velocity-low",
+    "ood-velocity-high",
+    "ood-radius-low",
+    "ood-radius-high",
+    "tiny",
+)
+
+
+def simulate_videos(
+    combinations: Sequence[tuple[float, float, float, float]],
+    rng: np.random.Generator,
+) -> tuple[np.ndarray, np.ndarray]:
+    """Simulate each combination; drops scenes PhyWorld would also drop."""
+
+    positions, init = [], []
+    for r1, r2, v1, v2 in combinations:
+        placement = sample_initial_positions(r1, r2, v1, v2, rng)
+        if placement is None:
+            continue
+        x1, x2, height = placement
+        positions.append(simulate_collision(r1, r2, v1, v2, x1, x2, height))
+        init.append((r1, r2, v1, v2))
+    if not positions:
+        raise RuntimeError("no scene could be placed")
+    return np.stack(positions), np.asarray(init, dtype=np.float64)
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--preset", choices=PRESETS, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--max-videos", type=int, help="random subset of the preset's combinations")
+    parser.add_argument("--with-video", action="store_true", help="also store 256x256 MP4s (needs imageio-ffmpeg)")
+    parser.add_argument("--chunk-size", type=int, default=1000)
+    parser.add_argument("--seed", type=int, default=42)
+    arguments = parser.parse_args(argv)
+
+    rng = np.random.default_rng(arguments.seed)
+    combinations = preset_combinations(arguments.preset, rng)
+    order = rng.permutation(len(combinations))
+    if arguments.max_videos is not None:
+        order = order[: arguments.max_videos]
+    combinations = [combinations[i] for i in order]
+    positions, init = simulate_videos(combinations, rng)
+    write_phyworld_file(
+        arguments.output,
+        positions,
+        init,
+        chunk_size=arguments.chunk_size,
+        with_video=arguments.with_video,
+    )
+    print(f"wrote {len(positions)} videos ({arguments.preset}) to {arguments.output}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/tasks/phyworld_collision/evaluation.py b/src/tasks/phyworld_collision/evaluation.py
new file mode 100644
index 0000000..f31a53d
--- /dev/null
+++ b/src/tasks/phyworld_collision/evaluation.py
@@ -0,0 +1,310 @@
+"""Evaluate a trained NEO on any number of episode files.
+
+::
+
+    python -m tasks.phyworld_collision.evaluation \\
+        --checkpoint runs/collision/neo/.../checkpoints/best.pt \\
+        --split id=data/collision/id_test.h5 \\
+        --split length_ood=data/collision/length_ood.h5 \\
+        --split velocity_ood=data/collision/velocity_ood.h5 \\
+        --output-dir runs/collision/eval
+
+For each split the program is inferred on the **support** pair (including its
+length, chosen by MDL) and executed on the **query** pair.  Reported:
+
+* ``query_loss`` / ``query_foreground_l1``: image (or state) error of the
+  transferred program, the L2T metric;
+* ``length_matches_delta``: how often the selected program length equals the
+  number of steps ``delta`` (did NEO learn "one primitive = one step"?);
+* physics errors of the query prediction in world units: ball **position**
+  at the last frame and ball **velocity**, measured by tracking the red and
+  blue balls (pixels) or read off the state vector (states).  Balls that are
+  not fully inside the target frame are excluded;
+* two reference predictors on the same episodes: ``copy`` (nothing moves) and
+  ``constant_velocity`` (true input positions extrapolated, no collision);
+* everything split by whether the query window contains the contact and by
+  ``delta``, plus which codebook entries the programs use.
+
+The number of program steps defaults to ``max(max_transition_length, largest
+delta in the split)`` so length-OOD splits can use longer programs.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from collections import Counter
+from pathlib import Path
+from typing import Any, Sequence
+
+import numpy as np
+import torch
+from torch.utils.data import DataLoader
+
+from tasks.phyworld_collision.data.dataset import EpisodeDataset, collate_episodes, load_metadata
+from tasks.phyworld_collision.physics import (
+    FRAME_DT,
+    WORLD_SCALE,
+    ball_centroids,
+    state_to_physical,
+)
+from tasks.phyworld_collision.task import load_neo_checkpoint
+from tasks.phyworld_collision.visualize import save_rows
+from training.runtime import bfloat16_autocast
+
+
+def _fully_inside(positions: np.ndarray, radii: np.ndarray) -> np.ndarray:
+    """``positions`` (N, 2, 2) and ``radii`` (N, 2) -> (N, 2) bool."""
+
+    low = positions - radii[..., None]
+    high = positions + radii[..., None]
+    return np.all((low >= 0.0) & (high <= WORLD_SCALE), axis=-1)
+
+
+def physics_from_pixels(observations: np.ndarray, frame_step: int) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    """Tracked last-frame centres, velocities and visibility from ``(N, S, S, 6)``."""
+
+    earlier = ball_centroids(observations[..., :3])
+    later = ball_centroids(observations[..., 3:6])
+    velocity = (later.centers - earlier.centers) / (frame_step * FRAME_DT)
+    return later.centers, velocity, earlier.visible & later.visible
+
+
+def physics_from_states(states: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    values = state_to_physical(states)
+    visible = np.ones(values["position"].shape[:2], dtype=bool)
+    return values["position"], values["velocity"], visible
+
+
+def _summary(values: np.ndarray, mask: np.ndarray) -> float | None:
+    selected = values[mask]
+    selected = selected[np.isfinite(selected)]
+    return float(selected.mean()) if selected.size else None
+
+
+@torch.no_grad()
+def evaluate_split(
+    model,
+    path: Path,
+    *,
+    batch_size: int,
+    num_transitions: int | None,
+    device: torch.device,
+    visualize: int,
+    output_dir: Path,
+    name: str,
+) -> dict[str, Any]:
+    observation = model.observation_config
+    training = model.experiment.training
+    dataset = EpisodeDataset(path, observation.modality)
+    metadata = load_metadata(path)
+    frame_step = int(dataset.attributes["frame_step"])
+    transitions = num_transitions or max(training.max_transition_length, int(metadata.delta.max()))
+    loader = DataLoader(dataset, batch_size=batch_size, shuffle=False, collate_fn=collate_episodes)
+    objective = model.objective
+    coefficient = training.length_control_end
+
+    per_episode: dict[str, list[np.ndarray]] = {
+        k: [] for k in ("index", "support_loss", "query_loss", "length", "codes", "pred_pos", "pred_vel", "pred_visible")
+    }
+    examples: list[list[np.ndarray]] = []
+    for batch in loader:
+        batch = batch.to(device)
+        with bfloat16_autocast(device):
+            output = model(
+                batch.observations,
+                is_eval=True,
+                length_control_coefficient=coefficient,
+                num_transitions=transitions,
+            )
+        inputs, targets = objective.split_batch(batch.observations)
+        predictions = output.predictions.float()
+        per_episode["index"].append(batch.indices.numpy())
+        per_episode["support_loss"].append(
+            objective.per_sample_reconstruction_loss(predictions[::2], targets[::2]).float().cpu().numpy()
+        )
+        per_episode["query_loss"].append(
+            objective.per_sample_reconstruction_loss(predictions[1::2], targets[1::2]).float().cpu().numpy()
+        )
+        per_episode["length"].append(output.selected_lengths[::2].cpu().numpy())
+        per_episode["codes"].append(
+            torch.stack([step.indices[::2] for step in output.action_vq_by_length], dim=1).cpu().numpy()
+        )
+        query_prediction = objective.decode_prediction(predictions[1::2]).float().cpu().numpy()
+        if observation.modality == "pixels":
+            position, velocity, visible = physics_from_pixels(query_prediction, frame_step)
+        else:
+            position, velocity, visible = physics_from_states(query_prediction)
+        per_episode["pred_pos"].append(position)
+        per_episode["pred_vel"].append(velocity)
+        per_episode["pred_visible"].append(visible)
+        if observation.modality == "pixels" and len(examples) < visualize:
+            observations = batch.observations.cpu().numpy()
+            support_prediction = objective.decode_prediction(predictions[::2]).float().cpu().numpy()
+            for i in range(min(visualize - len(examples), len(batch))):
+                examples.append(
+                    [
+                        observations[i, 0],
+                        observations[i, 1],
+                        support_prediction[i],
+                        observations[i, 2],
+                        observations[i, 3],
+                        query_prediction[i],
+                    ]
+                )
+
+    data = {k: np.concatenate(v) for k, v in per_episode.items()}
+    order = np.argsort(data["index"])
+    data = {k: v[order] for k, v in data.items()}
+
+    # Ground truth for the query pair (slot 2 = input, slot 3 = target).
+    true_in = metadata.positions[:, 2]  # (N, frame, ball, xy)
+    true_out = metadata.positions[:, 3]
+    query_radii = metadata.radii[:, 1]
+    step_time = frame_step * FRAME_DT
+    true_pos = true_out[:, 1]
+    true_vel = (true_out[:, 1] - true_out[:, 0]) / step_time
+    trackable = _fully_inside(true_out[:, 0], query_radii) & _fully_inside(true_out[:, 1], query_radii)
+    detected = data["pred_visible"] & trackable
+
+    elapsed = (metadata.delta * frame_step * FRAME_DT)[:, None, None]
+    input_vel = (true_in[:, 1] - true_in[:, 0]) / step_time
+    baselines = {
+        "copy": (true_in[:, 1], input_vel),
+        "constant_velocity": (true_in[:, 1] + input_vel * elapsed, input_vel),
+    }
+
+    def errors(position: np.ndarray, velocity: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+        return (
+            np.linalg.norm(position - true_pos, axis=-1),
+            np.linalg.norm(velocity - true_vel, axis=-1),
+        )
+
+    model_pos_err, model_vel_err = errors(data["pred_pos"], data["pred_vel"])
+    baseline_errors = {key: errors(*value) for key, value in baselines.items()}
+
+    def block(mask_episode: np.ndarray) -> dict[str, Any]:
+        ball_mask = trackable & mask_episode[:, None]
+        model_mask = detected & mask_episode[:, None]
+        result = {
+            "episodes": int(mask_episode.sum()),
+            "query_loss": _summary(data["query_loss"], mask_episode),
+            "support_loss": _summary(data["support_loss"], mask_episode),
+            "length_matches_delta": _summary(
+                (data["length"] == metadata.delta).astype(float), mask_episode
+            ),
+            "mean_selected_length": _summary(data["length"].astype(float), mask_episode),
+            "ball_detection_rate": float(model_mask.sum() / max(ball_mask.sum(), 1)),
+            "position_error": _summary(model_pos_err, model_mask),
+            "velocity_error": _summary(model_vel_err, model_mask),
+        }
+        for key, (pos_err, vel_err) in baseline_errors.items():
+            result[f"{key}_position_error"] = _summary(pos_err, ball_mask)
+            result[f"{key}_velocity_error"] = _summary(vel_err, ball_mask)
+        return result
+
+    everything = np.ones(len(metadata.delta), dtype=bool)
+    collides = metadata.collides[:, 1]
+    report: dict[str, Any] = {
+        "split": name,
+        "path": str(path),
+        "num_transitions": transitions,
+        "frame_step": frame_step,
+        "all": block(everything),
+        "query_window_with_collision": block(collides),
+        "query_window_without_collision": block(~collides),
+        "by_delta": {int(d): block(metadata.delta == d) for d in np.unique(metadata.delta)},
+    }
+
+    programs = [
+        "-".join(str(c) for c in codes[:length]) for codes, length in zip(data["codes"], data["length"])
+    ]
+    report["programs"] = {
+        "most_common": Counter(programs).most_common(15),
+        "with_collision": Counter(p for p, c in zip(programs, collides) if c).most_common(8),
+        "without_collision": Counter(p for p, c in zip(programs, collides) if not c).most_common(8),
+        "by_delta": {
+            int(d): Counter(p for p, dd in zip(programs, metadata.delta) if dd == d).most_common(5)
+            for d in np.unique(metadata.delta)
+        },
+    }
+    first_codes = data["codes"][:, 0]
+    report["codebook_usage_first_step"] = {
+        int(c): int(n) for c, n in zip(*np.unique(first_codes, return_counts=True))
+    }
+
+    if examples:
+        save_rows(output_dir / f"{name}_examples.png", examples)
+        report["examples_png"] = str(output_dir / f"{name}_examples.png")
+        report["examples_columns"] = [
+            "support x", "support y", "support prediction", "query x", "query y", "query prediction"
+        ]
+    return report
+
+
+def _parse_split(text: str) -> tuple[str, Path]:
+    name, separator, path = text.partition("=")
+    if not separator or not name or not path:
+        raise argparse.ArgumentTypeError("use --split NAME=PATH")
+    return name, Path(path)
+
+
+def _format_row(name: str, block: dict[str, Any]) -> str:
+    def fmt(value: Any) -> str:
+        return "   n/a" if value is None else f"{value:6.3f}"
+
+    return (
+        f"{name:<34}{block['episodes']:>7}  {fmt(block['query_loss'])}  {fmt(block['length_matches_delta'])}"
+        f"  {fmt(block['position_error'])}  {fmt(block['velocity_error'])}"
+        f"  {fmt(block['constant_velocity_velocity_error'])}  {fmt(block['copy_velocity_error'])}"
+    )
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--checkpoint", type=Path, required=True)
+    parser.add_argument("--split", type=_parse_split, action="append", required=True, metavar="NAME=PATH")
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--batch-size", type=int, default=256)
+    parser.add_argument("--num-transitions", type=int, help="program steps (default: see above)")
+    parser.add_argument("--visualize", type=int, default=8, help="example episodes to draw per split")
+    parser.add_argument("--cpu", action="store_true")
+    arguments = parser.parse_args(argv)
+
+    device = torch.device("cuda" if torch.cuda.is_available() and not arguments.cpu else "cpu")
+    model = load_neo_checkpoint(arguments.checkpoint, device)
+    arguments.output_dir.mkdir(parents=True, exist_ok=True)
+    reports = {}
+    for name, path in arguments.split:
+        reports[name] = evaluate_split(
+            model,
+            path,
+            batch_size=arguments.batch_size,
+            num_transitions=arguments.num_transitions,
+            device=device,
+            visualize=arguments.visualize,
+            output_dir=arguments.output_dir,
+            name=name,
+        )
+    (arguments.output_dir / "evaluation.json").write_text(json.dumps(reports, indent=2))
+
+    header = (
+        f"{'split / subset':<34}{'eps':>7}  {'qloss':>6}  {'len=Δ':>6}  {'pos_err':>6}  {'vel_err':>6}"
+        f"  {'cv_vel':>6}  {'cp_vel':>6}"
+    )
+    print(header)
+    print("-" * len(header))
+    for name, report in reports.items():
+        print(_format_row(f"{name}", report["all"]))
+        print(_format_row(f"{name} / collision in window", report["query_window_with_collision"]))
+        print(_format_row(f"{name} / no collision", report["query_window_without_collision"]))
+    print(
+        "\npos/vel errors are in world units (the world is 10 wide); cv = constant-velocity "
+        "reference, cp = copy reference.\nFull report: "
+        + str(arguments.output_dir / "evaluation.json")
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/tasks/phyworld_collision/experiment_config.py b/src/tasks/phyworld_collision/experiment_config.py
new file mode 100644
index 0000000..c426d73
--- /dev/null
+++ b/src/tasks/phyworld_collision/experiment_config.py
@@ -0,0 +1,156 @@
+"""NEO settings for the PhyWorld collision task.
+
+Defaults follow ImageEditing (the paper's continuous-image task) with three
+changes for physics:
+
+* ``max_transition_length = 4`` to match the training deltas 1-4, so a
+  program of length ``delta`` can be "one step of physics" repeated;
+* a small codebook (``action_codebook_size = 8``) so the model cannot keep a
+  separate code for every situation and has to reuse primitives;
+* one GPU (``world_size`` is whatever ``torchrun`` gives; batch 128).
+
+Every field can be overridden from the command line with ``--set name=value``.
+The observation fields (``modality``, ``state_dim``, image size, ...) are
+taken from the pretrained observation checkpoint, not set here.
+"""
+
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass, fields, replace
+from typing import Any, Mapping, Sequence
+
+
+@dataclass(frozen=True, slots=True)
+class TrainingConfig:
+    """One resolved NEO training condition (satisfies ``NEOTrainingConfig``)."""
+
+    # schedule
+    epochs: int = 50
+    batch_size: int = 128
+    num_workers: int = 4
+
+    # latent program shape (state_dim / num_state_tokens come from the VAE)
+    max_transition_length: int = 4
+    state_dim: int = 256
+    action_dim: int = 16
+    num_state_tokens: int = 1
+    num_action_tokens: int = 1
+    policy_hidden_dim: int = 256
+    transition_hidden_dim: int = 256
+    policy_film_layers: int = 4
+    transition_film_layers: int = 4
+    dropout: float = 0.0
+
+    # action codebook
+    action_codebook_size: int = 8
+    action_commitment_weight: float = 0.25
+    action_entropy_weight: float = 0.1
+    action_entropy_temperature: float = 1.0
+    action_ema_decay: float = 0.99
+    action_ema_epsilon: float = 1e-5
+    action_tau_start: float = 0.3  # protocol fields; the EMA quantizer does not anneal
+    action_tau_end: float = 0.1
+
+    # optimisation
+    learning_rate: float = 1e-3
+    policy_learning_rate_scale: float = 0.25
+    transition_learning_rate_scale: float = 0.5
+    weight_decay: float = 0.01
+    warmup_ratio: float = 0.05
+    minimum_learning_rate_ratio: float = 0.1
+    gradient_clip_norm: float = 1.0
+
+    # objective
+    reconstruction_weight: float = 1.0
+    grounding_weight: float = 0.1
+    state_prediction_weight: float = 0.5
+    action_vq_weight: float = 0.5
+    auto_reconstruction_weight: float = 0.0
+    adaptive_grounding: bool = True
+    foreground_weight: float = 10.0
+
+    # MDL length control (>1 penalises longer programs)
+    length_control_start: float = 1.01
+    length_control_end: float = 1.01
+
+    # frozen observation model
+    freeze_observation_encoder: bool = True
+    freeze_observation_decoder: bool = True
+
+    # checkpoints
+    checkpoint_interval_epochs: int = 5
+    log_interval_steps: int = 50
+
+    def __post_init__(self) -> None:
+        if self.epochs < 1 or self.batch_size < 1:
+            raise ValueError("epochs and batch_size must be positive")
+        if self.max_transition_length < 1:
+            raise ValueError("max_transition_length must be positive")
+        if self.action_codebook_size < 2:
+            raise ValueError("action_codebook_size must be at least 2")
+
+    @property
+    def action_tau_steps(self) -> int:
+        return 0
+
+    @property
+    def length_control_coefficient(self) -> float:
+        return self.length_control_start
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+    @classmethod
+    def from_dict(cls, values: Mapping[str, Any]) -> "TrainingConfig":
+        known = {f.name for f in fields(cls)}
+        return cls(**{k: v for k, v in values.items() if k in known})
+
+
+@dataclass(frozen=True, slots=True)
+class Experiment:
+    """Satisfies ``models.config.NEOExperimentConfig``."""
+
+    training: TrainingConfig
+
+    @property
+    def length_control_coefficient(self) -> float:
+        return self.training.length_control_start
+
+    def scheduled_length_control(self, progress: float) -> float:
+        """Linear schedule from ``length_control_start`` to ``length_control_end``."""
+
+        progress = min(max(progress, 0.0), 1.0)
+        start, end = self.training.length_control_start, self.training.length_control_end
+        return start + (end - start) * progress
+
+
+def _coerce(field_type: Any, text: str) -> Any:
+    kind = field_type if isinstance(field_type, str) else getattr(field_type, "__name__", str(field_type))
+    if kind == "bool":
+        if text.lower() in ("1", "true", "yes", "on"):
+            return True
+        if text.lower() in ("0", "false", "no", "off"):
+            return False
+        raise ValueError(f"not a boolean: {text!r}")
+    if kind == "int":
+        return int(text)
+    if kind == "float":
+        return float(text)
+    return text
+
+
+def apply_overrides(config: TrainingConfig, assignments: Sequence[str]) -> TrainingConfig:
+    """Apply ``name=value`` strings, e.g. ``["epochs=10", "action_codebook_size=4"]``."""
+
+    types = {f.name: f.type for f in fields(TrainingConfig)}
+    updates: dict[str, Any] = {}
+    for assignment in assignments:
+        name, separator, value = assignment.partition("=")
+        name = name.strip()
+        if not separator or name not in types:
+            raise ValueError(f"unknown setting {assignment!r}; valid names: {', '.join(sorted(types))}")
+        updates[name] = _coerce(types[name], value.strip())
+    return replace(config, **updates)
+
+
+__all__ = ["Experiment", "TrainingConfig", "apply_overrides"]
